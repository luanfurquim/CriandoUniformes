# Criando Uniformes — landing estática

DirectoryIndex index.html

# Uma URL só: https://criandouniformes.com/. As regras valem só para o domínio do cliente,
# para o endereço temporário da hospedagem continuar testável.
# X-Forwarded-Proto: na HostGator o TLS termina antes do Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^(www\.)?criandouniformes\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://criandouniformes.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.criandouniformes\.com$ [NC]
  RewriteRule ^(.*)$ https://criandouniformes.com/$1 [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Ninguém exibe a página dentro de outro site (clickjacking).
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Navegador só aceita https por 1 ano. O navegador ignora o cabeçalho em http.
  Header set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Sem listagem de pasta.
Options -Indexes
